#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D sourceColor;
layout(set=0,binding=1) uniform sampler2D sourceDepth;
layout(set=0,binding=2) uniform sampler2D surfaces;
layout(set=0,binding=3) uniform sampler2D shadowMap;
layout(rgba8,set=0,binding=4) uniform writeonly image2D outputColor;
layout(std140,set=0,binding=5) uniform Camera {
    mat4 inverseVP; mat4 currentVP; mat4 lightVP;
    vec4 sunDirection; vec4 sunColor; vec4 sky; vec4 sizeFlags;
} camera;

ivec2 size(){return ivec2(camera.sizeFlags.xy);}
vec4 surface(ivec2 p){
    p=clamp(p,ivec2(0),size()-1);
    vec4 s=texelFetch(surfaces,p,0);
    if(texelFetch(sourceDepth,p,0).r+0.000001<s.z)s.w=0.0;
    return s;
}
float depth(ivec2 p){vec4 s=surface(p);return s.w>0.5?s.z:texelFetch(sourceDepth,clamp(p,ivec2(0),size()-1),0).r;}
vec3 position(ivec2 p) {
    p=clamp(p,ivec2(0),size()-1);
    vec4 v=camera.inverseVP*vec4((vec2(p)+0.5)/vec2(size())*2.0-1.0,depth(p)*2.0-1.0,1.0);
    return v.xyz/v.w;
}
vec3 normalAt(ivec2 p,vec3 origin) {
    vec3 left=origin-position(p-ivec2(1,0)),right=position(p+ivec2(1,0))-origin;
    vec3 down=origin-position(p-ivec2(0,1)),up=position(p+ivec2(0,1))-origin;
    vec3 n=cross(dot(left,left)<dot(right,right)?left:right,dot(down,down)<dot(up,up)?down:up);
    if(dot(n,n)<1e-12)return normalize(-origin);
    n=normalize(n);return dot(n,origin)>0.0?-n:n;
}
float visibility(vec3 origin,vec3 normal) {
    vec4 light=camera.lightVP*vec4(origin+normal*0.035,1.0);
    vec3 uv=light.xyz/light.w;uv.xy=uv.xy*0.5+0.5;
    if(any(lessThan(uv,vec3(0.0)))||any(greaterThan(uv,vec3(1.0))))return 1.0;
    float result=0.0,bias=0.00035+0.0008*(1.0-max(0.0,dot(normal,camera.sunDirection.xyz)));
    vec2 texel=1.0/vec2(textureSize(shadowMap,0));
    for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++)
        result+=uv.z-bias<=texture(shadowMap,uv.xy+vec2(x,y)*texel).r?1.0:0.0;
    float fade=smoothstep(camera.sunDirection.w*0.8,camera.sunDirection.w,length(origin));
    return mix(result/9.0,1.0,fade);
}
vec3 lit(ivec2 p) {
    vec3 base=texelFetch(sourceColor,p,0).rgb;
    vec4 s=surface(p);
    if(s.w<0.5||s.z>=0.999999)return base;
    vec3 origin=position(p),normal=normalAt(p,origin);
    float sunlight=clamp(max(max(camera.sunColor.r,camera.sunColor.g),camera.sunColor.b),0.0,1.0);
    float direct=s.x*sunlight*max(0.0,dot(normal,camera.sunDirection.xyz));
    float visible=camera.sizeFlags.z>0.5?visibility(origin,normal):1.0;
    // Preserve the block-light/ambient baseline; shadow only the skylit contribution.
    return base*(1.0-0.7*direct*(1.0-visible));
}
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,size())))return;
    vec4 base=texelFetch(sourceColor,p,0),s=surface(p);
    vec3 color=lit(p);
    if(camera.sizeFlags.w>0.5&&s.w>0.5&&s.y>0.0&&s.z<0.999999) {
        vec3 origin=position(p),normal=normalAt(p,origin),view=normalize(origin);
        vec3 ray=reflect(view,normal);
        float fresnel=0.04+0.96*pow(1.0-max(0.0,dot(-view,normal)),5.0);
        float previousDistance=0.0,previousBehind=-1.0;
        // shortcut: SSR cannot reflect off-screen or hidden geometry; add probes if full-scene reflections are needed.
        for(int step=1;step<=40;step++) {
            float distance=0.08*float(step*step);
            vec3 point=origin+normal*0.06+ray*distance;
            vec4 clip=camera.currentVP*vec4(point,1.0);
            if(clip.w<=0.0)break;
            vec3 projected=clip.xyz/clip.w;
            vec2 uv=projected.xy*0.5+0.5;
            if(any(lessThanEqual(uv,vec2(0.0)))||any(greaterThanEqual(uv,vec2(1.0)))||abs(projected.z)>1.0)break;
            ivec2 hit=ivec2(uv*vec2(size()));
            if(depth(hit)>=0.999999){previousDistance=distance;previousBehind=-1.0;continue;}
            vec3 receiver=position(hit);
            float behind=dot(point-receiver,normalize(point));
            if(step>2&&behind>0.0&&previousBehind<=0.0) {
                float low=previousDistance,high=distance;
                for(int refine=0;refine<5;refine++) {
                    float middle=(low+high)*0.5;
                    vec3 candidate=origin+normal*0.06+ray*middle;
                    vec4 projectedHit=camera.currentVP*vec4(candidate,1.0);
                    vec2 hitUv=projectedHit.xy/projectedHit.w*0.5+0.5;
                    ivec2 hitPixel=clamp(ivec2(hitUv*vec2(size())),ivec2(0),size()-1);
                    if(depth(hitPixel)<0.999999&&dot(candidate-position(hitPixel),normalize(candidate))>0.0)high=middle;
                    else low=middle;
                }
                point=origin+normal*0.06+ray*high;
                clip=camera.currentVP*vec4(point,1.0);uv=clip.xy/clip.w*0.5+0.5;
                hit=clamp(ivec2(uv*vec2(size())),ivec2(0),size()-1);receiver=position(hit);
                float error=dot(point-receiver,normalize(point));
                if(error>=0.0&&error<0.15+high*0.012&&length(receiver-origin)>0.2) {
                    float edge=smoothstep(0.0,0.08,min(min(uv.x,uv.y),min(1.0-uv.x,1.0-uv.y)));
                    color=mix(color,lit(hit),s.y*fresnel*edge*(1.0-float(step)/45.0));break;
                }
            }
            previousDistance=distance;previousBehind=behind;
        }
    }
    imageStore(outputColor,p,vec4(clamp(color,0.0,1.0),base.a));
}
